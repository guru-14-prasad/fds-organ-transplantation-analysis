role='dimension' type='nominal'/><column datatype="integer" name="[Deceased_Donors]" role='measure' type='quantitative'/><column datatype="integer" name="[Living_Donors]" role='measure' type='quantitative'/><column datatype="integer" name="[Total_Donors]" role='measure' type='quantitative'/><column datatype="real" name="[Donor_Rate_PMP]" role='measure' type='quantitative'/><column datatype="real" name="[Deceased_Rate_PMP]" role='measure' type='quantitative'/><column datatype="integer" name="[Transplants]" role='measure' type='quantitative'/><column datatype="real" name="[Living_Donor_Pct]" role='measure' type='quantitative'/><column datatype="real" name="[Deceased_Donor_Pct]" role='measure' type='quantitative'/><column datatype="integer" name="[Waiting_List]" role='measure' type='quantitative'/><column datatype="real" name="[Avg_Wait_Years_US]" role='measure' type='quantitative'/><column datatype="real" name="[Survival_Rate_1Y_Pct]" role='measure' type='quantitative'/><column datatype="real" name="[Survival_Rate_5Y_Pct]" role='measure' type='quantitative'/><column datatype='string' name="[Can_Living_Donate]" role='dimension' type='nominal'/><column datatype='string' name="[Continent_Original]" role='dimension' type='nominal'/><column datatype='integer' name="[Year_Original]" role='dimension' type='ordinal'/><column caption="Burden Ratio (record)" datatype="real" name="[Calculation_1001]" role="measure" type="quantitative"><calculation class='tableau' formula="[Waiting_List] / IF [Transplants] &lt; 1 THEN 1 ELSE [Transplants] END"/></column><column caption="Country-Organ" datatype="string" name="[Calculation_1002]" role="dimension" type="nominal"><calculation class='tableau' formula='[Country] + " - " + [Organ]'/></column><column caption="Survival Drop 1Y to 5Y (pp)" datatype="real" name="[Calculation_1003]" role="measure" type="quantitative"><calculation class='tableau' formula="[Survival_Rate_1Y_Pct] - [Survival_Rate_5Y_Pct]"/></column><column caption="Country Priority" datatype="string" name="[Calculation_1004]" role="dimension" type="nominal"><calculation class='tableau' formula='IF {FIXED [Country] : SUM([Waiting_List])} / {FIXED [Country] : SUM([Transplants])} &gt; {FIXED : SUM([Waiting_List])} / {FIXED : SUM([Transplants])} AND {FIXED [Country] : MEDIAN([Donor_Rate_PMP])} &lt; {FIXED : MEDIAN([Donor_Rate_PMP])} THEN "Priority: high waitlist burden, low donor rate" ELSE "Other countries" END'/></column><column caption="Waiting List per Transplant" datatype="real" name="[Calculation_1005]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([Waiting_List]) / SUM([Transplants])"/></column><layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.5' show-structure='true'/><semantic-values><semantic-value key='[Country].[Name]' value='%null%'/></semantic-values></datasource></datasources><worksheets><worksheet name="Q1 Continent Donor Volume"><layout-options><title><formatted-text><run>Q1 — Total donors by continent</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="Organ Donation (cleaned)" name="federated.organdonation0001"/></datasources><datasource-dependencies datasource="federated.organdonation0001"><column datatype='string' name="[Continent]" role='dimension' type='nominal'/><column datatype="integer" name="[Total_Donors]" role='measure' type='quantitative'/><column-instance column="[Total_Donors]" derivation="Sum" name="[sum:Total_Donors:qk]" pivot='key' type="quantitative"/><column-instance column="[Continent]" derivation="None" name="[none:Continent:nk]" pivot='key' type="nominal"/></datasource-dependencies><sort class='computed' column="[federated.organdonation0001].[none:Continent:nk]" direction='DESC' using="[federated.organdonation0001].[sum:Total_Donors:qk]"/><aggregation value='true'/></view><style/><panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='aut