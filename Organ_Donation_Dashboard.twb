one:Organ:nk]</rows><cols>[federated.organdonation0001].[avg:Avg_Wait_Years_US:qk]</cols></table></worksheet><worksheet name="C1 Priority Matrix"><layout-options><title><formatted-text><run>Conclusion — Where donation lags and waitlists pile up (each dot = country)</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="Organ Donation (cleaned)" name="federated.organdonation0001"/></datasources><datasource-dependencies datasource="federated.organdonation0001"><column caption="Country Priority" datatype="string" name="[Calculation_1004]" role="dimension" type="nominal"><calculation class='tableau' formula='IF {FIXED [Country] : SUM([Waiting_List])} / {FIXED [Country] : SUM([Transplants])} &gt; {FIXED : SUM([Waiting_List])} / {FIXED : SUM([Transplants])} AND {FIXED [Country] : MEDIAN([Donor_Rate_PMP])} &lt; {FIXED : MEDIAN([Donor_Rate_PMP])} THEN "Priority: high waitlist burden, low donor rate" ELSE "Other countries" END'/></column><column caption="Waiting List per Transplant" datatype="real" name="[Calculation_1005]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([Waiting_List]) / SUM([Transplants])"/></column><column caption='Country' datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[Name]' type='nominal'/><column datatype="real" name="[Donor_Rate_PMP]" role='measure' type='quantitative'/><column datatype="integer" name="[Transplants]" role='measure' type='quantitative'/><column datatype="integer" name="[Waiting_List]" role='measure' type='quantitative'/><column-instance column="[Donor_Rate_PMP]" derivation="Median" name="[med:Donor_Rate_PMP:qk]" pivot='key' type="quantitative"/><column-instance column="[Calculation_1005]" derivation="User" name="[usr:Calculation_1005:qk]" pivot='key' type="quantitative"/><column-instance column="[Country]" derivation="None" name="[none:Country:nk]" pivot='key' type="nominal"/><column-instance column="[Calculation_1004]" derivation="None" name="[none:Calculation_1004:nk]" pivot='key' type="nominal"/><column-instance column="[Waiting_List]" derivation="Sum" name="[sum:Waiting_List:qk]" pivot='key' type="quantitative"/></datasource-dependencies><filter class='categorical' column="[federated.organdonation0001].[none:Country:nk]"><groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'><groupfilter function='level-members' level="[Country]"/><groupfilter function='member' level="[Country]" member='%null%'/></groupfilter></filter><aggregation value='true'/></view><style/><panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto'/></view><mark class="Circle"/><encodings><color column="[federated.organdonation0001].[none:Calculation_1004:nk]"/><size column="[federated.organdonation0001].[sum:Waiting_List:qk]"/><lod column="[federated.organdonation0001].[none:Country:nk]"/></encodings><style><style-rule element='mark'><encoding attr='color' field="[federated.organdonation0001].[none:Calculation_1004:nk]" type='palette'><map to='#d62728'><bucket>&quot;Priority: high waitlist burden, low donor rate&quot;</bucket></map><map to='#b8b8b8'><bucket>&quot;Other countries&quot;</bucket></map></encoding></style-rule></style></pane></panes><rows>[federated.organdonation0001].[usr:Calculation_1005:qk]</rows><cols>[federated.organdonation0001].[med:Donor_Rate_PMP:qk]</cols></table></worksheet><worksheet name="C2 Priority Ranking"><layout-options><title><formatted-text><run>Conclusion — Waiting list per transplant by country (priority countries highlighted)</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="Organ Donation (cleaned)" name="federated.organdonation0001"/></datasources><datasource-dependencies datasource="federated.organdonation0001"><column caption="Country Priority" datatype="string" name="[Calculation_1004]" role="dimension" type="nominal"><calculation class='tableau' formula='IF {FIXED [Country] : SUM([Waiting_List])} / {FIXED [Country] : SUM([Transplants])} &gt; {FIXED : SUM([Waiting_List])} / {FIXED : SUM([Transplants])} AND {FIXED [Country] : MEDIAN([Donor_Rate_PMP])} &lt; {FIXED : MEDIAN([Donor_Rate_PMP])} THEN "Priority: high waitlist burden, low donor rate" ELSE "Other countries" END'/></column><column caption="Waiting List per Transplant" datatype="real" name="[Calculation_1005]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([Waiting_List]) / SUM([Transplants])"/></column><column caption='Country' datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[Name]' type='nominal'/><column datatype="real" name="[Donor_Rate_PMP]" role='measure' type='quantitative'/><column datatype="integer" name="[Transplants]" role='measure' type='quantitative'/><column datatype="integer" name="[Waiting_List]" role='measure' type='quantitative'/><column-instance column="[Calculation_1005]" derivation="User" name="[usr:Calculation_1005:qk]" pivot='key' type="quantitative"/><column-instance column="[Country]" derivation="None" name="[none:Country:nk]" pivot='key' type="nominal"/><column-instance column="[Calculation_1004]" derivation="None" name="[none:Calculation_1004:nk]" pivot='key' type="nominal"/></datasource-dependencies><filter class='categorical' column="[federated.organdonation0001].[none:Country:nk]"><groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'><groupfilter function='level-members' level="[Country]"/><groupfilter function='member' level="[Country]" member='%null%'/></groupfilter></filter><sort class='computed' column="[federated.organdonation0001].[none:Country:nk]" direction='DESC' using="[federated.organdonation0001].[usr:Calculation_1005:qk]"/><aggregation value='true'/></view><style/><panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto'/></view><mark class="Bar"/><encodings><color column="[federated.organdonation0001].[none:Calculation_1004:nk]"/></encodings><style><style-rule element='mark'><encoding attr='color' field="[federated.organdonation0001].[none:Calculation_1004:nk]" type='palette'><map to='#d62728'><bucket>&quot;Priority: high waitlist burden, low donor rate&quot;</bucket></map><map to='#b8b8b8'><bucket>&quot;Other countries&quot;</bucket></map></encoding></style-rule></style></pane></panes><rows>[federated.organdonation0001].[none:Country:nk]</rows><cols>[federated.organdonation0001].[usr:Calculation_1005:qk]</cols></table></worksheet></worksheets><dashboards><dashboard name="1 Supply &amp; Geography"><style/><size maxheight='1500' maxwidth='1600' minheight='1500' minwidth='1600'/><zones><zone h='100000' id='15' type-v2='layout-basic' w='100000' x='0' y='0'><zone h='100000' id='16' param='vert' type-v2='layout-flow' w='100000' x='0' y='0'><zone h='7000' id='4' type-v2='text' w='100000' x='0' y='0'><formatted-text><run fontsize='20' bold='true'>Global Organ Donation — Supply &amp; Geography</run><run fontsize='11' fontcolor='#555555'>
Q1–Q4 plus country ranking and donor-rate map. Source: final_organ_dataset.csv (cleaned).</run></formatted-text></zone><zone h='31620' id='5' param='horz' type-v2='layout-flow' w='100000' x='0' y='7000'><zone h='31620' id='6' name="Q1 Continent Donor Volume" w='33333' x='0' y='7000'/><zone h='31620' id='7' name="Q3 Donor Rate by Continent" w='33333' x='33333' y='7000'/><zone h='31620' id='8' name="Q4 Living vs Deceased" w='33333' x='66666' y='7000'/></zone><zone h='30690' id='9' param='horz' type-v2='layout-flow' w='100000' x='0' y='38620'><zone h='30690' id='10' name="Q2 Top 15 Countries" w='50000' x='0' y='38620'/><zone h='30690' id='11' name="X1 Map Donor Rate" w='50000' x='50000' y='38620'/></zone><zone h='30690' id='12' param='horz' type-v2='layout-flow' w='100000' x='0' y='69310'><zone h='30690' id='13' name="X3 Donors Over Time by Continent" w='50000' x='0' y='69310'/><zone h='30690' id='14' name="Q13 Transplants Over Time" w='50000' x='50000' y='69310'/></zone></zone></zone></zones></dashboard><dashboard name="2 Organs: Transplants, Waitlists &amp; Survival"><style/><size maxheight='1700' maxwidth='1600' minheight='1700' minwidth='1600'/><zones><zone h='100000' id='20' type-v2='layout-basic' w='100000' x='0' y='0'><zone h='100000' id='21' param='vert' type-v2='layout-flow' w='100000' x='0' y='0'><zone h='7000' id='4' type-v2='text' w='100000' x='0' y='0'><formatted-text><run fontsize='20' bold='true'>Organ-Level Analysis — Transplants, Waiting Lists &amp; Survival</run><run fontsize='11' fontcolor='#555555'>
Q5, Q6, Q9–Q12, Q15 plus supply/demand, wait time and survival-drop views.</run></formatted-text></zone><zone h='23250' id='5' param='horz' type-v2='layout-flow' w='100000' x='0' y='7000'><zone h='23250' id='6' name="Q5 Transplants by Organ" w='33333' x='0' y='7000'/><zone h='23250' id='7' name="Q6 Waiting List by Organ" w='33333' x='33333' y='7000'/><zone h='23250' id='8' name="X2 Supply vs Demand" w='33333' x='66666' y='7000'/></zone><zone h='23250' id='9' param='horz' type-v2='layout-flow' w='100000' x='0' y='30250'><zone h='23250' id='10' name="Q9 1Y Survival by Organ" w='33333' x='0' y='30250'/><zone h='23250' id='11' name="Q10 5Y Survival by Organ" w='33333' x='33333' y='30250'/><zone h='23250' id='12' name="Q11 1Y vs 5Y Survival" w='33333' x='66666' y='30250'/></zone><zone h='23250' id='13' param='horz' type-v2='layout-flow' w='100000' x='0' y='53500'><zone h='23250' id='14' name="X5 Survival Drop by Organ" w='33333' x='0' y='53500'/><zone h='23250' id='15' name="X6 Wait Time by Organ" w='33333' x='33333' y='53500'/><zone h='23250' id='16' name="Q12 Living Donor Share" w='33333' x='66666' y='53500'/></zone><zone h='23250' id='17' param='horz' type-v2='layout-flow' w='100000' x='0' y='76750'><zone h='23250' id='18' name="Q15 Eligibility vs Living Share" w='50000' x='0' y='76750'/><zone h='23250' id='19' name="X4 Burden Heatmap" w='50000' x='50000' y='76750'/></zone></zone></zone></zones></dashboard><dashboard name="3 Relationships &amp; Burden"><style/><size maxheight='1000' maxwidth='1600' minheight='1000' minwidth='1600'/><zones><zone h='100000' id='10' type-v2='layout-basic' w='100000' x='0' y='0'><zone h='100000' id='11' param='vert' type-v2='layout-flow' w='100000' x='0' y='0'><zone h='7000' id='4' type-v2='text' w='100000' x='0' y='0'><formatted-text><run fontsize='20' bold='true'>Relationships &amp; Waiting-List Burden</run><run fontsize='11' fontcolor='#555555'>
Q7, Q8 and Q14: how donors, donor rates, transplants and waiting lists relate.</run></formatted-text></zone><zone h='46500' id='5' param='horz' type-v2='layout-flow' w='100000' x='0' y='7000'><zone h='46500' id='6' name="Q7 Donors vs Transplants" w='50000' x='0' y='7000'/><zone h='46500' id='7' name="Q8 Donor Rate vs Waitlist" w='50000' x='50000' y='7000'/></zone><zone h='46500' id='8' param='horz' type-v2='layout-flow' w='100000' x='0' y='53500'><zone h='46500' id='9' name="Q14 Waitlist-to-Transplant" w='100000' x='0' y='53500'/></zone></zone></zone></zones></dashboard><dashboard name="4 Conclusion"><style/><size maxheight='1250' maxwidth='1600' minheight='1250' minwidth='1600'/><zones><zone h='100000' id='10' type-v2='layout-basic' w='100000' x='0' y='0'><zone h='100000' id='11' param='vert' type-v2='layout-flow' w='100000' x='0' y='0'><zone h='7000' id='4' type-v2='text' w='100000' x='0' y='0'><formatted-text><run fontsize='20' bold='true'>Conclusion — Where to Focus Next</run><run fontsize='11' fontcolor='#555555'>
Priority = waiting list per transplant above the global ratio AND median donor rate below the global median.</run></formatted-text></zone><zone h='33480' id='5' param='horz' type-v2='layout-flow' w='100000' x='0' y='7000'><zone h='33480' id='6' type-v2='text' w='100000' x='0' y='7000'><formatted-text><run fontsize='16' bold='true'>Conclusion
</run><run fontsize='11'>The analysis indicates that donation supply and waiting-list demand are badly mismatched in a small set of countries. </run><run fontsize='11'>Across the cleaned data, the median country has about 2.1 donors per million, while the dataset-wide waiting list is about 9.4 people per transplant. </run><run fontsize='11' bold='true'>Pakistan (≈69 waiting per transplant), Kenya (≈42), Egypt (≈38), China (≈19) and Thailand (≈16) combine below-median donor rates with above-average waitlist burden — the red dots in the matrix below.

</run><run fontsize='11' bold='true'>Supporting evidence: </run><run fontsize='11'>donors track transplants strongly (r ≈ 0.70, Q7), but donor rate barely explains waitlist size (Spearman ≈ 0.33, Q8), so raw donor volume alone does not fix backlog. Kidney carries the largest transplant volume and waiting list (Q5, Q6) and the best survival (≈97% at 1 year, ≈90% at 5 years), while intestine and lung show the steepest 5-year survival drop (Q10, X5). Living donation matters mainly for kidney (≈37% median share) and liver (≈23%) (Q12, Q15).

</run><run fontsize='11' bold='true'>Recommendation: </run><run fontsize='11'>prioritise the red-flagged countries for further evaluation — donor-registration and deceased-donation programmes, and expanded living-donor kidney/liver pathways — subject to data limits: observational data, possible projected/synthetic records, repeated country-organ-year rows, and cleaning corrections (continent spelling and country mapping, impossible years blanked). Not for clinical decisions.</run></formatted-text></zone></zone><zone h='59520' id='7' param='horz' type-v2='layout-flow' w='100000' x='0' y='40480'><zone h='59520' id='8' name="C1 Priority Matrix" w='55000' x='0' y='40480'/><zone h='59520' id='9' name="C2 Priority Ranking" w='45000' x='55000' y='40480'/></zone></zone></zone></zones></dashboard></dashboards><windows source-height='30'><window class='dashboard' name="1 Supply &amp; Geography"><viewpoints/><active id='-1'/></window><window class='dashboard' name="2 Organs: Transplants, Waitlists &amp; Survival"><viewpoints/><active id='-1'/></window><window class='dashboard' name="3 Relationships &amp; Burden"><viewpoints/><active id='-1'/></window><window class='dashboard' name="4 Conclusion"><viewpoints/><active id='-1'/></window><window class='worksheet' name="Q1 Continent Donor Volume"><cards><edge name='left'><strip size='160'><card type='pages'/><card type='filters'/><card type='marks'/></strip></edge><edge name='top'><strip size='2147483647'><card type='columns'/></strip><strip size='2147483647'><card type='rows'/></strip><strip size='31'><card type='title'/></strip></edge></cards></window><window class='worksheet' name="Q2 Top 15 Countries"><cards><edge name='left'><strip size='160'><card type='pages'/><card type='filters'/><card type='marks'/></strip></edge><edge name='top'><strip size='2147483647'><card type='columns'/></strip><strip size='2147483647'><card type='rows'/></strip><strip size='31'><card type='title'/></strip></edge></cards></window><window class='work